[Unit]
Description=AegisVault FastAPI Backend Service
PartOf=aegisvault.target
After=network.target postgresql.service redis.service

[Service]
Type=simple
User={{AEGIS_USER}}
WorkingDirectory={{AEGIS_ROOT}}
EnvironmentFile={{AEGIS_ROOT}}/.env
Environment="PYTHONPATH={{AEGIS_ROOT}}:{{AEGIS_ROOT}}/sdk/python"
ExecStart={{AEGIS_ROOT}}/apps/api/.venv/bin/python -m uvicorn apps.api.app.main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

# Security Hardening
PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true

[Install]
WantedBy=aegisvault.target
