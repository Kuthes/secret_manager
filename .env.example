# AegisVault Security & Secrets Platform Configuration

ENVIRONMENT=development
DEMO_MODE=true
DEBUG=false

# Database & Cache
POSTGRES_USER=aegisvault
POSTGRES_PASSWORD=aegisvault_dev_pass
POSTGRES_DB=aegisvault
DATABASE_URL=postgresql+asyncpg://aegisvault:aegisvault_dev_pass@localhost:5432/aegisvault
REDIS_URL=redis://localhost:6379/0

# Master Key Encryption Key (MEK)
# In production, generate a cryptographically secure 32-byte key base64 encoded:
# python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=TESTONLY_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
MEK_ID=mek-v1

# Security & JWT Tokens
SECRET_KEY=TESTONLY_insecure_jwt_secret_key_for_development_must_be_changed_in_prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP / Email Alerts
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@aegisvault.local

# Web Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
