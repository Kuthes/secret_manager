# ==========================================
# AegisVault Staging Environment Config
# ==========================================

# 1. Deployment Mode
ENVIRONMENT=staging
DEBUG=false
DEMO_MODE=false

# 2. Database (PostgreSQL 16)
POSTGRES_USER=aegisvault_staging
POSTGRES_PASSWORD=generate_secure_random_postgres_password_here
POSTGRES_DB=aegisvault_staging
DATABASE_URL=postgresql+asyncpg://aegisvault_staging:generate_secure_random_postgres_password_here@postgres:5432/aegisvault_staging

# 3. Cache & Message Broker (Redis 7)
REDIS_URL=redis://redis:6379/0

# 4. Cryptography & Security
# Generate 32-byte Base64 key: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=YOUR_BASE64_ENCODED_32_BYTE_MEK_HERE
MEK_ID=mek-staging-v1
KMS_PROVIDER_TYPE=local

# Generate 64-char JWT signing key: openssl rand -hex 32
SECRET_KEY=YOUR_HEX_ENCODED_64_CHAR_JWT_SECRET_KEY_HERE
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 5. Frontend & Networking
NEXT_PUBLIC_API_URL=https://staging-api.yourdomain.com/api/v1
BACKEND_CORS_ORIGINS=["https://staging.yourdomain.com","https://staging-api.yourdomain.com","http://localhost:3000"]
